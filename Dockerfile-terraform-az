FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

# ---- Versions you can override at build time ----
ARG TENV_VERSION=4.9.3
ARG KUBECTL_CHANNEL=v1.35
ARG KUBELOGIN_VERSION=0.2.15
# https://github.com/derailed/k9s/releases/
ARG K9S_VERSION=v0.50.18
# https://github.com/anthropics/claude-code/releases (apt: stable channel)
# Leave empty to track the repo's newest stable at build time.
ARG CLAUDE_CODE_VERSION=2.1.126-1

# ---- Non-root user settings ----
ARG USERNAME=ubuntu
ARG HOME=/home/ubuntu
ARG UID=1000
ARG GID=1000

# OCI runtimes may not set $HOME reliably when running with user namespaces.
# Export it explicitly so shells and CLIs behave consistently.
ENV HOME=${HOME}

# ---- Base deps ----
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    unzip \
    git \
    gnupg \
    lsb-release \
    bash-completion

# Ensure bash completion is enabled for login shells (/etc/profile -> /etc/profile.d/*.sh)
RUN printf '%s\n' \
  'if [ -n "$BASH_VERSION" ] && [ -f /usr/share/bash-completion/bash_completion ]; then' \
  '  . /usr/share/bash-completion/bash_completion' \
  'fi' \
  > /etc/profile.d/bash_completion.sh

# Ensure bash completion is enabled for interactive non-login shells (/etc/bash.bashrc)
RUN if ! grep -q '/usr/share/bash-completion/bash_completion' /etc/bash.bashrc; then \
      printf '\n# Enable bash completion\nif [ -f /usr/share/bash-completion/bash_completion ]; then\n  . /usr/share/bash-completion/bash_completion\nfi\n' >> /etc/bash.bashrc; \
    fi

# ---- Install Azure CLI (az) from Microsoft's repo ----
RUN mkdir -p /etc/apt/keyrings \
  && curl -sLS https://packages.microsoft.com/keys/microsoft.asc \
    | gpg --dearmor > /etc/apt/keyrings/microsoft.gpg \
  && chmod go+r /etc/apt/keyrings/microsoft.gpg \
  && AZ_REPO="$(lsb_release -cs)" \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/azure-cli/ ${AZ_REPO} main" \
    > /etc/apt/sources.list.d/azure-cli.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends azure-cli

# ---- Install kubectl (apt) ----
# Override at build time e.g.: --build-arg KUBECTL_CHANNEL=v1.32
RUN mkdir -p /etc/apt/keyrings \
  && curl -fsSL "https://pkgs.k8s.io/core:/stable:/${KUBECTL_CHANNEL}/deb/Release.key" \
    | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg \
  && chmod 0644 /etc/apt/keyrings/kubernetes-apt-keyring.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/${KUBECTL_CHANNEL}/deb/ /" \
    > /etc/apt/sources.list.d/kubernetes.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends kubectl

# ---- Install Helm (apt) ----
# Repo details per https://helm.sh/docs/intro/install/ (Buildkite-hosted APT repo)
RUN mkdir -p /usr/share/keyrings \
  && curl -fsSL https://packages.buildkite.com/helm-linux/helm-debian/gpgkey \
    | gpg --dearmor -o /usr/share/keyrings/helm.gpg \
  && chmod 0644 /usr/share/keyrings/helm.gpg \
  && echo "deb [signed-by=/usr/share/keyrings/helm.gpg] https://packages.buildkite.com/helm-linux/helm-debian/any/ any main" \
    > /etc/apt/sources.list.d/helm-stable-debian.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends helm

# ---- Install kubelogin (GitHub release) ----
RUN set -eux; \
  arch="$(dpkg --print-architecture)"; \
  case "${arch}" in \
    amd64) kubelogin_arch="linux-amd64" ;; \
    arm64) kubelogin_arch="linux-arm64" ;; \
    armhf) kubelogin_arch="linux-armv7" ;; \
    *) echo "Unsupported architecture for kubelogin: ${arch}" >&2; exit 1 ;; \
  esac; \
  base="kubelogin-${kubelogin_arch}.zip"; \
  url="https://github.com/Azure/kubelogin/releases/download/v${KUBELOGIN_VERSION}/${base}"; \
  curl -fsSL -o "/tmp/${base}" "${url}"; \
  curl -fsSL -o "/tmp/${base}.sha256" "${url}.sha256"; \
  (cd /tmp && sha256sum -c "${base}.sha256"); \
  rm -rf /tmp/kubelogin-unpack; \
  unzip -q "/tmp/${base}" -d /tmp/kubelogin-unpack; \
  kubelogin_bin="$(find /tmp/kubelogin-unpack -type f -name kubelogin | head -n 1)"; \
  test -n "${kubelogin_bin}"; \
  install -m 0755 "${kubelogin_bin}" /usr/local/bin/kubelogin; \
  ls -l /usr/local/bin/kubelogin; \
  /usr/local/bin/kubelogin --version; \
  rm -rf "/tmp/${base}" "/tmp/${base}.sha256" /tmp/kubelogin-unpack

# ---- Bash completion for installed CLIs ----
RUN mkdir -p /etc/bash_completion.d \
  && kubectl completion bash > /etc/bash_completion.d/kubectl \
  && helm completion bash > /etc/bash_completion.d/helm \
  && ( \
    if az completion -h >/dev/null 2>&1; then \
      (az completion -o bash 2>/dev/null || az completion --shell bash 2>/dev/null) > /etc/bash_completion.d/az \
        || echo "Azure CLI completion command exists but failed; skipping." >&2; \
    elif [ -f /usr/share/bash-completion/completions/azure-cli ]; then \
      cp /usr/share/bash-completion/completions/azure-cli /etc/bash_completion.d/az; \
    elif [ -f /usr/share/bash-completion/completions/az ]; then \
      cp /usr/share/bash-completion/completions/az /etc/bash_completion.d/az; \
    elif [ -f /etc/bash_completion.d/azure-cli ]; then \
      cp /etc/bash_completion.d/azure-cli /etc/bash_completion.d/az; \
    else \
      echo "Azure CLI bash completion script not found; skipping." >&2; \
    fi \
  )

# ---- Install tenv ----
# Installs to /usr/local/bin/tenv
RUN curl -fsSL "https://github.com/tofuutils/tenv/releases/download/v${TENV_VERSION}/tenv_v${TENV_VERSION}_linux_x86_64.tar.gz" \
    | tar -xzv -C /usr/local/bin tenv \
  && chmod +x /usr/local/bin/tenv

# ---- Install k9s (GitHub release) ----
RUN set -eux; \
  arch="$(dpkg --print-architecture)"; \
  case "$arch" in \
    amd64) k9s_arch="Linux_amd64" ;; \
    arm64) k9s_arch="Linux_arm64" ;; \
    armhf) k9s_arch="Linux_armv7" ;; \
    *) echo "Unsupported architecture for k9s: $arch" >&2; exit 1 ;; \
  esac; \
  base="k9s_${k9s_arch}.tar.gz"; \
  url="https://github.com/derailed/k9s/releases/download/${K9S_VERSION}/${base}"; \
  curl -fsSL -o "/tmp/${base}" "$url"; \
  tar -xzvf "/tmp/${base}" -C /usr/local/bin k9s; \
  chmod +x /usr/local/bin/k9s; \
  rm -f "/tmp/${base}"; \
  /usr/local/bin/k9s version || true

# ---- Install Claude Code (apt) ----
# Signed repo per https://code.claude.com/docs/en/setup
# The package is a self-contained native binary (Depends: libc6 only) -- no Node.js needed.
RUN set -eux; \
  mkdir -p /etc/apt/keyrings; \
  curl -fsSL https://downloads.claude.ai/keys/claude-code.asc -o /tmp/claude-code.asc; \
  gpg --show-keys --with-colons /tmp/claude-code.asc \
    | grep -q '^fpr:::::::::31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE:'; \
  gpg --dearmor -o /etc/apt/keyrings/claude-code.gpg /tmp/claude-code.asc; \
  chmod 0644 /etc/apt/keyrings/claude-code.gpg; \
  rm -f /tmp/claude-code.asc; \
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/claude-code.gpg] https://downloads.claude.ai/claude-code/apt/stable stable main" \
    > /etc/apt/sources.list.d/claude-code.list; \
  apt-get update; \
  apt-get install -y --no-install-recommends "claude-code${CLAUDE_CODE_VERSION:+=${CLAUDE_CODE_VERSION}}"; \
  claude --version

# ---- Install some software to be able work inside ----
RUN apt-get install -y vim

# ---- Cleanup -----
RUN rm -rf /var/lib/apt/lists/*

# ---- Create non-root user and workspace dirs ----
RUN mkdir -p ${HOME}/bin /work \
  && chown -R ${UID}:${GID} ${HOME} /work
USER ${USERNAME}
ENV PATH="${HOME}/bin:${PATH}"
# The Claude Code version is pinned by apt; don't let it update itself out from under the image.
ENV DISABLE_AUTOUPDATER=1
WORKDIR /work

# Start an interactive login shell by default so /etc/profile.d/* runs and bash-completion is enabled.
CMD ["bash", "-l"]
